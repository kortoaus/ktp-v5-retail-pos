PORT=2200
API_URL="http://localhost:3000"
API_KEY="testmuyaho"
DATABASE_URL="postgresql://ktpv5:510935@localhost:5438/retail_pos_local_dev?connection_limit=5&pool_timeout=30"

# Stripe Terminal / Tap to Pay — OPTIONAL (Fast Checkout tablet only).
# Absent  → /api/stripe/* answers 503 {ok:false,msg:"Stripe is not configured"}
#           and the tablet hides its Tap to Pay button. Nothing else breaks.
# STRIPE_LOCATION_ID is also optional: the server reuses (or creates) a Terminal
# Location and logs the id with a "pin it here" warning.
STRIPE_SECRET_KEY=""
STRIPE_LOCATION_ID=""

# Staff sessions (R-1, src/v1/user/staff-session.ts).
# STAFF_SESSION_SECRET — HMAC secret for staff session tokens (long random
#   string, per store). Unset → random per boot + one WARN; sessions then end
#   at every server restart.
# STAFF_AUTH_ACCEPT — both (default) | session. `both` still accepts the legacy
#   `<userId>%%%<ts>` token (Runner / old tills) with one INFO line per request;
#   switch to `session` only after every till and Runner build is updated.
STAFF_SESSION_SECRET=
STAFF_AUTH_ACCEPT=both
